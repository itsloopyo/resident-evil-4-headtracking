# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Windows batch files must be CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.png binary
*.jpg binary
*.gif binary
*.zip binary

# The committed canonical config is the table's fresh render byte for byte, CRLF included.
HeadTracking.ini -text

# The config differential test's inputs are the published files byte for byte, CRLF included,
# and its oracle is the published build's sources byte for byte.
tests/config_differential/inputs/** -text
tests/config_differential/oracle/** -text
